# For PCBs designed using KiCad: https://www.kicad.org/
# Format documentation: https://kicad.org/help/file-formats/

# Temporary files
*.000
*.bak
*.bck
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups
*-cache*
*-bak
*-bak*
*~
~*
_autosave-*
\#auto_saved_files\#
*.tmp
*-save.pro
*-save.kicad_pcb
fp-info-cache
~*.lck
\#auto_saved_files#

# Netlist files (exported from Eeschema)
*.net

# Autorouter files (exported from Pcbnew)
*.dsn
*.ses

# Exported BOM files
*.xml
*.csv

# Archived Backups (KiCad 6.0)
**/*-backups/*.zip

# Local git-based history (KiCad 9.0+)
.history

# Local project settings
*.kicad_prl

/dfm

ibom.html

*.csv

*.zip

ordered.zip

.serena

# ---------------------------------------------------------------------------
# KiCad reports and exports not covered above
# ---------------------------------------------------------------------------
*.rpt
*.drc
*.erc
*.pos
*.lck
_autosave*
*.orig
*.rej

# Other archive formats (matches the *.zip rule above)
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# ---------------------------------------------------------------------------
# Editors / IDEs
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.iml
*.sublime-workspace
*.swp
*.swo
.nfs*

# ---------------------------------------------------------------------------
# OS cruft
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.directory
.Trash-*
.fuse_hidden*

# ---------------------------------------------------------------------------
# Python (KiCad plugins, action scripts, helper tooling)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.python-version

# ---------------------------------------------------------------------------
# Embedded build output (Arduino / PlatformIO / esptool)
# NOTE: *.log is deliberately NOT ignored: code/*.log flash logs are tracked.
# ---------------------------------------------------------------------------
.pio/
.pioenvs/
.piolibdeps/
build/
*.elf
*.hex
*.uf2
*.map
node_modules/
npm-debug.log*

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# AI tooling local state
# ---------------------------------------------------------------------------
.claude/settings.local.json
CLAUDE.local.md
.aider*