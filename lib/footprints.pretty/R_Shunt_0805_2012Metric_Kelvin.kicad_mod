(footprint "R_Shunt_0805_2012Metric_Kelvin"
	(version 20260206)
	(generator "hand")
	(layer "F.Cu")
	(descr "0805 (2012 Metric) 2-terminal chip shunt on a pseudo-Kelvin 4-pad land. Each end cap is split into a wide current pad and a narrow sense pad; the two connect only through the resistor termination. Pad numbering matches parsnip R41 symbol: 1=current -BATT / 2=sense CSP (left), 4=current GND / 3=sense CSN (right). NOT a true 4-terminal device - both pads at an end share one solder joint, so this removes trace/via IR from the sense path but not the termination/joint drop.")
